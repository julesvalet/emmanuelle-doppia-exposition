# PayPal REST API (Orders v2) — sandbox credentials by default.
# Get sandbox Client ID/Secret from https://developer.paypal.com/dashboard/applications/sandbox

# Server-side only (used by /api/create-order and /api/capture-order).
# NEVER expose the secret to the client.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# "sandbox" (default) or "live". Keep "sandbox" until real payments are validated.
PAYPAL_ENV=sandbox

# Client-side (Vite only exposes VITE_-prefixed variables to the browser bundle).
# Same value as PAYPAL_CLIENT_ID above — this one IS public, it's the PayPal Client ID,
# not the secret.
VITE_PAYPAL_CLIENT_ID=

# Supabase project (customer accounts + order history).
# Client-side only — safe to expose because Row Level Security is enabled on every table
# the anon key can reach (see supabase/migrations/0001_commandes.sql).
# Find both values in the Supabase dashboard: Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by /api/capture-order to record each paid order in "commandes" —
# see supabase/migrations/0002 and 0003). This key bypasses Row Level Security entirely:
# NEVER expose it to the client, never prefix it with VITE_.
# Find it in the Supabase dashboard: Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) — sends the order notification email to
# emmanuelledoppia@photo-ml.fr after a PayPal payment is successfully captured
# (used by /api/capture-order only, server-side).
# Get an API key from https://resend.com/api-keys (free tier is enough for this volume).
RESEND_API_KEY=

# The "From" address for that email. Resend only lets you send from a domain you've verified
# in their dashboard (https://resend.com/domains) — until photo-ml.fr (or another domain) is
# verified there, leave this unset and Resend's own onboarding@resend.dev sender is used
# instead (works out of the box, no verification needed, but looks less official).
RESEND_FROM_EMAIL=
